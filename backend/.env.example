# -----------------------------------------------------------------------------
# Backend Environment Configuration
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
CALLER_AUTH_TOKENS=fde-rep-101:secret-fde-token-1,fde-rep-102:secret-fde-token-2,admin:admin-secret-token:admin

# CORS Allowed Origins
# Explicit list of origins permitted to access this API.
# Staging default: https://coldcall-companion.vercel.app. Update if using a custom production domain.
CORS_ORIGINS=http://localhost:5173,https://coldcall-companion.vercel.app

# Trusted Proxies for Rate Limiting & Client IP Extraction
# Comma-separated list of IP addresses or CIDR blocks of upstream reverse proxies.
# Forwarding headers (CF-Connecting-IP, X-Forwarded-For) are trusted ONLY when the immediate connection originates from these IPs.
#
# SECURITY CAUTION:
# Do NOT blindly configure broad subnets (like 10.0.0.0/8) or enable TRUST_PRIVATE_PROXIES=true unless
# your backend is hosted inside a private network where untrusted direct internet traffic cannot reach it.
# If your backend service is directly addressable on the public internet, leave these unset or specify only
# the exact, verified egress IP addresses of your reverse proxy.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# TRUST_PRIVATE_PROXIES=false

# LLM Debrief Configuration
LLM_API_KEY=YOUR_SERVER_ONLY_LLM_KEY
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Server-Side Contact Webhook
# Private incoming webhook for Slack, Discord, or Zapier/Make. Kept strictly server-side.
# Leave unset or empty until a verified webhook is configured.
CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRIVATE/WEBHOOK
