# =============================================================================
# COLDCALL COMPANION — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to backend/.env and frontend/.env respectively, or configure
# these directly in your deployment platform (Render for backend, Vercel for frontend).

# -----------------------------------------------------------------------------
# BACKEND ENVIRONMENT (Render / Local FastAPI)
# -----------------------------------------------------------------------------
# Supabase PostgreSQL configuration (Server-only; NEVER expose to frontend or git)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Caller Authentication & Authorization Tokens (comma-separated list: caller_id:token or caller_id:token:role)
CALLER_AUTH_TOKENS=fde-rep-101:secret-fde-token-1,fde-rep-102:secret-fde-token-2,admin:admin-secret-token:admin

# Allowed CORS origins (comma-separated list of origins; no wildcards with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_FRONTEND.vercel.app

# Optional LLM configuration for post-call AI coaching debriefs
LLM_API_KEY=YOUR_OPENAI_OR_COMPATIBLE_API_KEY
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# FRONTEND ENVIRONMENT (Vercel / Local Vite)
# -----------------------------------------------------------------------------
# Public API base URL pointing to the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
