# -----------------------------------------------------------------------------
# Frontend Environment Variables (Build-time baked)
# -----------------------------------------------------------------------------

# Backend API Base URL
# - Development: defaults to http://localhost:8000
# - Production: REQUIRED when deploying frontend and backend to separate origins.
#   Set to your public backend URL (e.g. https://api.yourdomain.com or https://coldcall-companion.onrender.com).
#   Never leave unconfigured in production.
VITE_API_BASE_URL=http://localhost:8000

# Optional Google Analytics 4 Measurement ID
# - Leave commented/unset to enforce zero tracking.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Public-Specific Contact Service Endpoint (e.g. Formspree/Basement)
# - Leave commented/unset to route inquiries to the backend server-side /contact endpoint.
# - DO NOT place private Slack/Discord/Zapier webhook URLs here.
# VITE_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
